<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress Semantic Kernel experimental API warnings (SKEXP000x) -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0050;SKEXP0070</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core AI & Connectors upgraded to latest 1.79.0 (.NET 10 compatible) -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.79.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.79.0-alpha" />
    
    <!-- Vector Database & Caching & PDF Parsing upgraded to latest versions -->
    <PackageReference Include="PdfPig" Version="0.1.16-alpha-20260811-39f52" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />

    <!-- .NET 10 Microsoft.Extensions packages -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduMind.Application\EduMind.Application.csproj" />
  </ItemGroup>

</Project>
